---
import Layout from './Layout.astro';
import { t, type Lang, getLocalizedPath } from '../i18n';
import type { BusinessUnit } from '../data/units';

interface Props {
  unit: BusinessUnit;
  lang: Lang;
}

const { unit, lang } = Astro.props;
const title = `${unit.name[lang]} — ${unit.subtitle[lang]} | Shema Yisrael S.R.L.`;
---

<Layout lang={lang} title={title} description={unit.description[lang].slice(0, 160)}>
  <!-- Hero with Wallpaper -->
  <section
    class="relative min-h-[60vh] flex items-center justify-center overflow-hidden"
    style={`background: linear-gradient(135deg, ${unit.colors.secondary} 0%, ${unit.colors.primary} 50%, ${unit.colors.secondary} 100%)`}
  >
    <!-- Animated background particles -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="particle particle-1" style={`background-color: ${unit.colors.accent}`}></div>
      <div class="particle particle-2" style={`background-color: ${unit.colors.light}`}></div>
      <div class="particle particle-3" style={`background-color: ${unit.colors.accent}`}></div>
    </div>

    <!-- Decorative Pattern -->
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-pattern" width="60" height="60" patternUnits="userSpaceOnUse">
            <circle cx="30" cy="30" r="1.5" fill="white"/>
            <circle cx="0" cy="0" r="1.5" fill="white"/>
            <circle cx="60" cy="0" r="1.5" fill="white"/>
            <circle cx="0" cy="60" r="1.5" fill="white"/>
            <circle cx="60" cy="60" r="1.5" fill="white"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid-pattern)"/>
      </svg>
    </div>

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 m bg-linear-to-b from-black/10 via-transparent to-black/30"></div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto py-24">
      <!-- Back link with animation -->
      <a
        href={getLocalizedPath('/', lang)}
        class="inline-flex items-center gap-2 text-white/70 hover:text-white text-sm 2xl:text-base mb-8 transition-all duration-300 hover:-translate-x-1 animate-fade-in"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        {t('unitPage.backHome', lang)}
      </a>

      <!-- Icon SVG with float animation -->
      <div class="mb-6 flex justify-center animate-fade-in-down">
        <div
          class="w-20 h-20 2xl:w-40 2xl:h-40 rounded-2xl flex items-center justify-center icon-float"
        >
          <img
            src={unit.iconRoute}
            alt={unit.name[lang]}
            class="w-full h-full object-contain filter brightness-0 invert"
          />
        </div>
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 tracking-tight animate-fade-in-up">
        {unit.name[lang]}
      </h1>
      <p class="text-xl md:text-2xl text-white/80 font-medium animate-fade-in-up delay-200">
        {unit.subtitle[lang]}
      </p>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
        <svg class="w-6 h-6 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </div>

    <!-- Bottom wave decoration -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" class="w-full h-auto">
        <path d="M0,60 C360,120 720,0 1440,60 L1440,120 L0,120 Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- About -->
      <div class="mb-16 animate-on-scroll">
        <div class="flex items-center gap-3 mb-6">
          <div
            class="w-1.5 h-8 rounded-full"
            style={`background: linear-gradient(180deg, ${unit.colors.primary}, ${unit.colors.accent})`}
          ></div>
          <h2
            class="text-2xl md:text-3xl font-bold"
            style={`color: ${unit.colors.primary}`}
          >
            {t('unitPage.aboutUnit', lang)}
          </h2>
        </div>
        <p class="text-gray-600 text-base md:text-lg leading-relaxed pl-5">
          {unit.description[lang]}
        </p>
      </div>

      <!-- Differentiator -->
      <div
        class="relative rounded-3xl p-8 md:p-10 mb-16 overflow-hidden animate-on-scroll-scale"
        style={`background-color: ${unit.colors.light}`}
      >
        <!-- Decorative corner -->
        <div
          class="absolute top-0 right-0 w-32 h-32 opacity-20 rounded-bl-full"
          style={`background: linear-gradient(135deg, ${unit.colors.primary}, ${unit.colors.accent})`}
        ></div>

        <div class="relative">
          <div class="flex items-center gap-3 mb-6">
            <svg
              class="w-8 h-8"
              style={`color: ${unit.colors.secondary}`}
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
            <h2
              class="text-2xl md:text-3xl font-bold"
              style={`color: ${unit.colors.secondary}`}
            >
              {t('unitPage.ourDifference', lang)}
            </h2>
          </div>
          <p class="text-gray-700 text-base md:text-lg leading-relaxed">
            {unit.differentiator[lang]}
          </p>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center animate-on-scroll">
        <a
          href={getLocalizedPath('/#contact', lang)}
          class="group inline-flex items-center gap-3 text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 hover:shadow-2xl text-sm md:text-base"
          style={`background: linear-gradient(135deg, ${unit.colors.primary}, ${unit.colors.secondary}); box-shadow: 0 10px 30px -5px ${unit.colors.primary}40`}
        >
          {t('unitPage.contactUs', lang)}
          <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Floating animation for icon */
  .icon-float {
    animation: iconFloat 4s ease-in-out infinite;
  }

  @keyframes iconFloat {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  /* Particle animations */
  .particle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.3;
  }

  .particle-1 {
    width: 300px;
    height: 300px;
    top: -100px;
    right: -100px;
    animation: particleMove1 20s ease-in-out infinite;
  }

  .particle-2 {
    width: 200px;
    height: 200px;
    bottom: -50px;
    left: -50px;
    animation: particleMove2 25s ease-in-out infinite;
  }

  .particle-3 {
    width: 150px;
    height: 150px;
    top: 45%;
    left: 50%;
    animation: particleMove3 15s ease-in-out infinite;
  }

  @keyframes particleMove1 {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-50px, 50px) scale(1.1);
    }
  }

  @keyframes particleMove2 {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(30px, -30px) scale(0.9);
    }
  }

  @keyframes particleMove3 {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.2;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.3);
      opacity: 0.4;
    }
  }

  /* Bounce animation for scroll indicator */
  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0) translateX(-50%);
    }
    40% {
      transform: translateY(-10px) translateX(-50%);
    }
    60% {
      transform: translateY(-5px) translateX(-50%);
    }
  }

  .animate-bounce {
    animation: bounce 2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-float,
    .particle,
    .animate-bounce {
      animation: none;
    }
  }
</style>
