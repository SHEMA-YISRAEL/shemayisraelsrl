---
import Layout from './Layout.astro';
import { t, type Lang, getLocalizedPath } from '../i18n';
import type { BusinessUnit } from '../data/units';

interface Props {
  unit: BusinessUnit;
  lang: Lang;
}

const { unit, lang } = Astro.props;
const title = `${unit.name[lang]} — ${unit.subtitle[lang]} | Shema Yisraelsss S.R.L.`;
---

<Layout lang={lang} title={title} description={unit.description[lang].slice(0, 160)}>
  <!-- Hero with Wallpaper -->
  <section
    class="relative min-h-[60vh] flex items-center justify-center overflow-hidden"
    style={`background: linear-gradient(135deg, ${unit.colors.secondary} 0%, ${unit.colors.primary} 50%, ${unit.colors.secondary} 100%)`}
  >
    <!-- Decorative Pattern -->
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-pattern" width="60" height="60" patternUnits="userSpaceOnUse">
            <circle cx="30" cy="30" r="1.5" fill="white"/>
            <circle cx="0" cy="0" r="1.5" fill="white"/>
            <circle cx="60" cy="0" r="1.5" fill="white"/>
            <circle cx="0" cy="60" r="1.5" fill="white"/>
            <circle cx="60" cy="60" r="1.5" fill="white"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid-pattern)"/>
      </svg>
    </div>

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-linear-to-b from-black/10 via-transparent to-black/30"></div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto py-24">
      <!-- Back link -->
      <a
        href={getLocalizedPath('/', lang)}
        class="inline-flex items-center gap-2 text-white/70 hover:text-white text-sm mb-8 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        {t('unitPage.backHome', lang)}
      </a>

      <!-- iconRoute SVG -->
      <div class="mb-6 flex justify-center">
        <div
          class="w-20 h-20 2xl:w-40 2xl:h-40 rounded-2xl flex items-center justify-center"
        >
          <img
            src={unit.iconRoute}
            alt={unit.name[lang]}
            class="w-full h-full object-contain filter brightness-0 invert"
          />
        </div>
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 tracking-tight">
        {unit.name[lang]}
      </h1>
      <p class="text-xl md:text-2xl text-white/80 font-medium">
        {unit.subtitle[lang]}
      </p>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- About -->
      <div class="mb-16">
        <h2
          class="text-2xl md:text-3xl font-bold mb-6"
          style={`color: ${unit.colors.primary}`}
        >
          {t('unitPage.aboutUnit', lang)}
        </h2>
        <p class="text-gray-600 text-base md:text-lg leading-relaxed">
          {unit.description[lang]}
        </p>
      </div>

      <!-- Differentiator -->
      <div
        class="rounded-2xl p-8 md:p-10 mb-16"
        style={`background-color: ${unit.colors.light}`}
      >
        <h2
          class="text-2xl md:text-3xl font-bold mb-6"
          style={`color: ${unit.colors.secondary}`}
        >
          {t('unitPage.ourDifference', lang)}
        </h2>
        <p class="text-gray-700 text-base md:text-lg leading-relaxed">
          {unit.differentiator[lang]}
        </p>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <a
          href={getLocalizedPath('/#contact', lang)}
          class="inline-flex items-center gap-2 text-white font-semibold px-8 py-3.5 rounded-full transition-all duration-300 hover:opacity-90 text-sm md:text-base shadow-lg"
          style={`background-color: ${unit.colors.primary}`}
        >
          {t('unitPage.contactUs', lang)}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
