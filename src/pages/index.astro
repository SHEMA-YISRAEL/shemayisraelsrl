---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/landing/Hero.astro';
import About from '../components/landing/About.astro';
import MissionVision from '../components/landing/MissionVision.astro';
import BusinessUnits from '../components/landing/BusinessUnits.astro';
import NetworkSection from '../components/landing/NetworkSection.astro';
import Contact from '../components/landing/Contact.astro';

const lang = 'es';

const title = 'Shema Yisrael S.R.L. | Innovación, excelencia y propósito';
const description =
  'Shema Yisrael S.R.L. es una empresa multidisciplinaria en salud, educación y tecnología, guiada por propósito, innovación, excelencia e impacto social.';
---

<Layout lang={lang} title={title} description={description}>
  <main>
    <Hero lang={lang} />
    <About lang={lang} />
    <MissionVision lang={lang} />
    <BusinessUnits lang={lang} />
    <NetworkSection lang={lang} />
    <Contact lang={lang} />
  </main>
</Layout>