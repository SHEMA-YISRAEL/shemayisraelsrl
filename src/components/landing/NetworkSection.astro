---
import { t, type Lang, getLocalizedPath } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const youtubeId = 'IJyYoCKnXB8';

const countries = [
  { key: 'korea', flag: '🇰🇷', emoji: true },
  { key: 'usa', flag: '🇺🇸', emoji: true },
  { key: 'bolivia', flag: '🇧🇴', emoji: true },
];
---

<section id="network" class="py-20 md:py-28 bg-gradient-to-b from-white via-slate-50 to-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16 animate-on-scroll">
      <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold tracking-wide bg-[#1e4b69]/10 text-[#1e4b69] mb-4">
        {t('network.badge', lang)}
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {t('network.title', lang)}
      </h2>
      <p class="text-lg md:text-xl text-gray-500 max-w-2xl mx-auto">
        {t('network.subtitle', lang)}
      </p>
    </div>

    <!-- Countries connection -->
    <div class="flex flex-col md:flex-row items-center justify-center gap-0 mb-12 md:mb-16 animate-on-scroll">
      {countries.map((country, i) => (
        <>
          <!-- Country -->
          <div class="flex flex-col items-center gap-2">
            <div class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-white shadow-lg flex items-center justify-center text-4xl md:text-5xl border-2 border-[#1e4b69]/10 hover:border-[#1e4b69]/30 hover:shadow-xl transition-all duration-300 hover:scale-105">
              {country.flag}
            </div>
            <span class="text-sm md:text-base font-semibold text-gray-700">
              {t(`network.${country.key}`, lang)}
            </span>
          </div>

          {/* Desktop arrow (horizontal) */}
          {i < countries.length - 1 && (
            <div class="hidden md:flex items-center mx-6">
              <div class="w-16 lg:w-24 h-0.5 bg-gradient-to-r from-[#1e4b69] to-[#2d78aa] rounded-full"></div>
              <svg class="w-5 h-5 text-[#2d78aa] -ml-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
            </div>
          )}

          {/* Mobile arrow (vertical) */}
          {i < countries.length - 1 && (
            <div class="flex md:hidden flex-col items-center my-3">
              <div class="w-0.5 h-6 bg-linear-to-b from-[#1e4b69] to-[#2d78aa] rounded-full"></div>
              <svg class="w-5 h-5 text-[#2d78aa] -mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 10.293a1 1 0 010 1.414l-6 6a1 1 0 01-1.414 0l-6-6a1 1 0 111.414-1.414L9 14.586V3a1 1 0 012 0v11.586l4.293-4.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
            </div>
          )}
        </>
      ))}
    </div>

    <!-- Video -->
    {youtubeId && (
      <div class="max-w-5xl mx-auto mb-12 md:mb-16 animate-on-scroll-scale">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl aspect-video" style="box-shadow: 0 25px 60px -12px rgba(30, 75, 105, 0.25);">
          <iframe
            src={`https://www.youtube.com/embed/${youtubeId}?rel=0&modestbranding=1`}
            title="Netiv Global"
            class="absolute inset-0 w-full h-full"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}

    <!-- Description -->
    <div class="max-w-3xl mx-auto text-justify mb-12 md:mb-16 animate-on-scroll">
      <p class="text-gray-600 text-base md:text-lg leading-relaxed">
        {t('network.description', lang)}
      </p>
    </div>

    <!-- CTA to Netiv -->
    <div class="text-center mt-10 animate-on-scroll">
      <a
        href={getLocalizedPath('/netiv', lang)}
        class="group inline-flex items-center gap-3 text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 hover:shadow-2xl text-sm md:text-base"
        style="background: linear-gradient(135deg, #1e4b69, #1b262c); box-shadow: 0 10px 30px -5px rgba(30, 75, 105, 0.4);"
      >
        Netiv Global
        <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
