---
import { t, type Lang, getLocalizedPath } from '../../i18n';
import { units } from '../../data/units';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="units" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-corp-primary mb-4">
        {t('units.title', lang)}
      </h2>
      <p class="text-corp-secondary text-lg md:text-xl font-medium">
        {t('units.subtitle', lang)}
      </p>
    </div>

    <!-- Units Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {units.map((unit) => (
        <a
          href={getLocalizedPath(`/${unit.slug}`, lang)}
          class="group relative rounded-2xl overflow-hidden bg-white border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-2"
        >
          <!-- Color bar top -->
          <div
            class="h-2 w-full"
            style={`background-color: ${unit.colors.primary}`}
          ></div>

          <div class="p-6 md:p-8">
            <!-- Icon + Name -->
            <div class="flex items-start gap-4 mb-4">
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl shrink-0"
                style={`background-color: ${unit.colors.light}`}
              >
                {unit.icon}
              </div>
              <div>
                <h3
                  class="text-lg font-bold group-hover:opacity-80 transition-opacity"
                  style={`color: ${unit.colors.primary}`}
                >
                  {unit.name[lang]}
                </h3>
                <p class="text-gray-400 text-sm font-medium">
                  {unit.subtitle[lang]}
                </p>
              </div>
            </div>

            <!-- Description -->
            <p class="text-gray-500 text-sm leading-relaxed line-clamp-3 mb-5">
              {unit.description[lang].slice(0, 150)}...
            </p>

            <!-- CTA -->
            <div
              class="inline-flex items-center gap-1.5 text-sm font-semibold group-hover:gap-3 transition-all duration-300"
              style={`color: ${unit.colors.primary}`}
            >
              {t('units.learnMore', lang)}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
