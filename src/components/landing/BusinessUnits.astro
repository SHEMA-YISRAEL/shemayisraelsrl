---
import { t, type Lang, getLocalizedPath } from '../../i18n';
import { units } from '../../data/units';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="units" class="py-20 md:py-28 bg-gradient-to-b from-white via-gray-50/50 to-white relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-corp-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-corp-secondary/5 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header with animation -->
    <div class="text-center mb-16 animate-on-scroll">
      <span class="inline-block px-4 py-1.5 bg-corp-primary/10 text-corp-primary text-sm font-semibold rounded-full mb-4">
        {t('units.badge', lang) || 'des'}
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-corp-primary mb-4">
        {t('units.title', lang)}
      </h2>
      <p class="text-corp-secondary text-lg md:text-xl font-medium max-w-2xl mx-auto">
        {t('units.subtitle', lang)}
      </p>
    </div>

    <!-- Units Grid - Improved cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {units.map((unit, index) => (
        <a
          href={getLocalizedPath(`/${unit.slug}`, lang)}
          class="unit-card group relative rounded-3xl overflow-hidden bg-white animate-on-scroll"
          style={`--unit-primary: ${unit.colors.primary}; --unit-secondary: ${unit.colors.secondary}; --unit-light: ${unit.colors.light}; --unit-accent: ${unit.colors.accent}; animation-delay: ${index * 100}ms;`}
        >
          <!-- Gradient background on hover -->
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            style={`background: linear-gradient(135deg, ${unit.colors.light} 0%, white 50%, ${unit.colors.light} 100%)`}
          ></div>

          <!-- Top accent bar with gradient -->
          <div
            class="h-1.5 w-full relative overflow-hidden"
            style={`background: linear-gradient(90deg, ${unit.colors.secondary}, ${unit.colors.primary}, ${unit.colors.accent})`}
          >
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000"></div>
          </div>

          <div class="relative p-7 md:p-8">
            <!-- Icon container with glow effect -->
            <div class="flex items-start gap-5 mb-5">
              <div
                class="relative w-16 h-16 rounded-2xl flex items-center justify-center p-3 shrink-0 transition-all duration-500 group-hover:scale-110 group-hover:rotate-3"
                style={`background: linear-gradient(135deg, ${unit.colors.light} 0%, ${unit.colors.accent}40 100%)`}
              >
                <!-- Glow effect behind icon -->
                <div
                  class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-60 blur-xl transition-opacity duration-500"
                  style={`background-color: ${unit.colors.primary}`}
                ></div>
                <img
                  src={unit.iconRoute}
                  alt={unit.name[lang]}
                  class="relative w-full h-full object-contain transition-transform duration-500"
                  style={`filter: brightness(0) saturate(100%);`}
                />
              </div>
              <div class="flex-1 min-w-0">
                <h3
                  class="text-xl font-bold mb-1 transition-all duration-300 group-hover:translate-x-1"
                  style={`color: ${unit.colors.primary}`}
                >
                  {unit.name[lang]}
                </h3>
                <p
                  class="text-sm font-medium transition-colors duration-300"
                  style={`color: ${unit.colors.secondary}`}
                >
                  {unit.subtitle[lang]}
                </p>
              </div>
            </div>

            <!-- Description with fade -->
            <p class="text-gray-600 text-sm leading-relaxed line-clamp-3 mb-6 group-hover:text-gray-700 transition-colors duration-300 text-justify">
              {unit.description[lang].slice(0, 150)}...
            </p>

            <!-- Enhanced CTA with arrow animation -->
            <div class="flex items-center justify-between">
              <div
                class="inline-flex items-center gap-2 text-sm font-bold transition-all duration-300"
                style={`color: ${unit.colors.primary}`}
              >
                <span class="relative">
                  {t('units.learnMore', lang)}
                  <span
                    class="absolute bottom-0 left-0 w-0 h-0.5 group-hover:w-full transition-all duration-300"
                    style={`background-color: ${unit.colors.primary}`}
                  ></span>
                </span>
                <svg
                  class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </div>

              <!-- Circular indicator -->
              <div
                class="w-10 h-10 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:scale-100 scale-75"
                style={`background-color: ${unit.colors.primary}`}
              >
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>
          </div>

          <!-- Bottom decorative element -->
          <div
            class="absolute bottom-0 left-0 right-0 h-1 transform translate-y-full group-hover:translate-y-0 transition-transform duration-300"
            style={`background: linear-gradient(90deg, ${unit.colors.primary}, ${unit.colors.accent})`}
          ></div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .unit-card {
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.05),
      0 2px 4px -2px rgba(0, 0, 0, 0.05);
    transition:
      transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      box-shadow 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      border-color 0.3s ease;
  }

  .unit-card:hover {
    transform: translateY(-12px) scale(1.02);
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.12),
      0 12px 24px -8px var(--unit-primary, rgba(0, 0, 0, 0.08));
    border-color: var(--unit-light);
  }

  /* Stagger animation delays */
  .unit-card:nth-child(1) { transition-delay: 0ms; }
  .unit-card:nth-child(2) { transition-delay: 50ms; }
  .unit-card:nth-child(3) { transition-delay: 100ms; }
  .unit-card:nth-child(4) { transition-delay: 150ms; }
  .unit-card:nth-child(5) { transition-delay: 200ms; }
  .unit-card:nth-child(6) { transition-delay: 250ms; }
  .unit-card:nth-child(7) { transition-delay: 300ms; }

  @media (prefers-reduced-motion: reduce) {
    .unit-card {
      transition: none;
    }
    .unit-card:hover {
      transform: none;
    }
  }
</style>
