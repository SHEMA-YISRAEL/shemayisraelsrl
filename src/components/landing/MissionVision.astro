---
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="mission" class="py-20 md:py-28 bg-gray-50 relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 right-0 w-96 h-96 bg-corp-primary/3 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-corp-secondary/3 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20">
      <!-- Mission -->
      <div class="animate-on-scroll-left">
        <div class="mb-2">
          <span class="inline-block px-3 py-1 bg-corp-primary/10 text-corp-secondary text-sm font-semibold uppercase tracking-widest rounded-full">
            {t('mission.subtitle', lang)}
          </span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-corp-primary mb-6">
          {t('mission.title', lang)}
        </h2>
        <p class="text-gray-600 leading-relaxed text-base md:text-lg mb-8 text-justify">
          {t('mission.text', lang)}
        </p>

        <!-- Quote -->
        <blockquote class="relative border-l-4 border-corp-secondary pl-6 py-2 bg-white/50 rounded-r-lg">
          <div class="absolute -left-3 top-4 w-6 h-6 bg-corp-secondary rounded-full flex items-center justify-center">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
          </div>
          <p class="text-gray-700 italic text-base md:text-lg leading-relaxed text-justify">
            "{t('mission.quote', lang)}"
          </p>
          <cite class="text-corp-secondary text-sm font-medium mt-3 block not-italic">
            — {t('mission.quoteAuthor', lang)}
          </cite>
        </blockquote>
      </div>

      <!-- Vision -->
      <div class="animate-on-scroll-right">
        <div class="mb-2">
          <span class="inline-block px-3 py-1 bg-corp-primary/10 text-corp-secondary text-sm font-semibold uppercase tracking-widest rounded-full">
            {t('vision.subtitle', lang)}
          </span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-corp-primary mb-6">
          {t('vision.title', lang)}
        </h2>
        <p class="text-gray-600 leading-relaxed text-base md:text-lg text-justify">
          {t('vision.text', lang)}
        </p>

        <!-- Decorative element -->
        <div class="mt-10 flex items-center gap-4">
          <div class="h-px flex-1 bg-linear-to-r from-corp-primary/20 to-transparent"></div>
          <div class="logo-pulse">
            <img src="/logo-primary.svg" alt="" class="h-15 2xl:h-23 w-auto"/>
          </div>
          <div class="h-px flex-1 bg-linear-to-l from-corp-primary/20 to-transparent"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .logo-pulse {
    animation: logoPulse 3s ease-in-out infinite;
  }

  @keyframes logoPulse {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.05);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-pulse {
      animation: none;
    }
  }
</style>
