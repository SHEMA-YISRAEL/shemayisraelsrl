---
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="mission" class="py-20 md:py-28 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20">
      <!-- Mission -->
      <div>
        <div class="mb-2">
          <span class="text-corp-secondary text-sm font-semibold uppercase tracking-widest">
            {t('mission.subtitle', lang)}
          </span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-corp-primary mb-6">
          {t('mission.title', lang)}
        </h2>
        <p class="text-gray-600 leading-relaxed text-base md:text-lg mb-8">
          {t('mission.text', lang)}
        </p>

        <!-- Quote -->
        <blockquote class="border-l-4 border-corp-secondary pl-6 py-2">
          <p class="text-gray-700 italic text-base md:text-lg leading-relaxed">
            "{t('mission.quote', lang)}"
          </p>
          <cite class="text-corp-secondary text-sm font-medium mt-3 block not-italic">
            — {t('mission.quoteAuthor', lang)}
          </cite>
        </blockquote>
      </div>

      <!-- Vision -->
      <div>
        <div class="mb-2">
          <span class="text-corp-secondary text-sm font-semibold uppercase tracking-widest">
            {t('vision.subtitle', lang)}
          </span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-corp-primary mb-6">
          {t('vision.title', lang)}
        </h2>
        <p class="text-gray-600 leading-relaxed text-base md:text-lg">
          {t('vision.text', lang)}
        </p>

        <!-- Decorative element -->
        <div class="mt-10 flex items-center gap-4">
          <div class="h-px flex-1 bg-linear-to-r from-corp-primary/20 to-transparent"></div>
          <img src="/logo-primary.svg" alt="" class="h-15 2xl:h-23 w-auto"/>
          <div class="h-px flex-1 bg-linear-to-l from-corp-primary/20 to-transparent"></div>
        </div>
      </div>
    </div>
  </div>
</section>
