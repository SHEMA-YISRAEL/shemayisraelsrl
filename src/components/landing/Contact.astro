---
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section
  id="contact"
  class="py-20 md:py-28 bg-gradient-to-b from-gray-50 to-white"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">

      <!-- Left: Info -->
      <div class="animate-on-scroll-left">
        <h2 class="text-3xl md:text-4xl font-bold text-corp-primary mb-4">
          {t('contact.title', lang)}
        </h2>

        <p class="text-gray-600 text-lg mb-10 max-w-xl text-justify">
          {t('contact.subtitle', lang)}
        </p>

        <div class="space-y-6">
          <div class="flex items-start gap-4 animate-on-scroll" style="animation-delay: 100ms;">
            <div class="w-11 h-11 bg-corp-light rounded-xl flex items-center justify-center shrink-0 text-corp-primary">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-corp-primary">Email</h4>
              <p class="text-gray-500 text-sm">
                administracion@shemayisraelsrl.com
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 animate-on-scroll" style="animation-delay: 200ms;">
            <div class="w-11 h-11 bg-corp-light rounded-xl flex items-center justify-center shrink-0 text-corp-primary">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-corp-primary">
                {lang === 'es' ? 'Ubicación' : 'Location'}
              </h4>
              <p class="text-gray-500 text-sm">
                <span>Torres América Norte, planta baja, Of.2 Av. América entre Av. Pando y Av. M. Urquidi</span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Map Card -->
      <div
        class="
          relative
          rounded-3xl
          overflow-hidden
          border border-gray-100
          shadow-md
          bg-white
          animate-on-scroll-right
        "
      >
        <!-- Map -->
        <div class="aspect-16/10 md:aspect-video lg:aspect-4/3">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d951.952325304845!2d-66.15183055168264!3d-17.372906916764485!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x93e3754f9934dbfb%3A0xd594f7fcbb987373!2sTorre%20Am%C3%A9rica%20Norte!5e0!3m2!1ses!2sbo!4v1718313796076!5m2!1ses!2sbo" width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <!-- Overlay info -->
        <div
          class="
            absolute
            left-4 bottom-4
            right-4
            md:left-6 md:bottom-6 md:right-auto
            bg-white/90
            backdrop-blur
            rounded-xl
            px-4 py-3
            shadow-sm
            flex items-center justify-between gap-4
          "
        >
          <div>
            <p class="text-sm font-semibold text-corp-primary">
              YESHUA Centro Médico Integral
            </p>
            <p class="text-xs text-gray-500">
              Torres América Norte, planta baja, Of.2
            </p>
          </div>

          <a
            href="https://www.google.com/maps/place/YESHUA+Centro+M%C3%A9dico+Integral"
            target="_blank"
            rel="noopener noreferrer"
            class="
              text-xs font-medium
              text-corp-primary
              hover:underline
              whitespace-nowrap
            "
          >
            {lang === 'es' ? 'Cómo llegar' : 'Get directions'}
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
