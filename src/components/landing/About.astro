---
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const pillars = [
  { key: 'teamwork', icon: '🤝' },
  { key: 'respect', icon: '🫱🏽‍🫲🏻' },
  { key: 'integrity', icon: '⚖️' },
  { key: 'growth', icon: '📈' },
  { key: 'excellence', icon: '⭐' },
  { key: 'innovation', icon: '💡' },
  { key: 'social', icon: '🌍' },
];
---

<section id="about" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-corp-primary mb-4">
        {t('about.title', lang)}
      </h2>
      <p class="text-corp-secondary text-lg md:text-xl font-medium">
        {t('about.subtitle', lang)}
      </p>
    </div>

    <!-- Intro -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <p class="text-gray-600 leading-relaxed text-base md:text-lg">
        {t('about.intro', lang)}
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {pillars.map((pillar) => (
        <div class="group bg-corp-light/50 hover:bg-corp-light border border-corp-primary/5 rounded-2xl p-6 text-center transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
          <div class="text-3xl mb-3">{pillar.icon}</div>
          <h3 class="text-corp-primary font-semibold text-base mb-2">
            {t(`about.pillars.${pillar.key}.title`, lang)}
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed">
            {t(`about.pillars.${pillar.key}.desc`, lang)}
          </p>
        </div>
      ))}

      <!-- Central pillar - YHWH -->
      <div class="bg-corp-primary text-white rounded-2xl p-6 text-center flex flex-col items-center justify-center shadow-lg">
        <div class="text-2xl mb-2 font-bold">יהוה</div>
        <div class="text-xs uppercase tracking-widest opacity-70">(YHWH)</div>
        <h3 class="font-semibold text-base mt-3">
          {lang === 'es' ? 'Dios como Pilar Fundamental' : 'God as Fundamental Pillar'}
        </h3>
      </div>
    </div>
  </div>
</section>
