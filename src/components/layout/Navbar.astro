
---
import { t, type Lang, getLocalizedPath } from '../../i18n';
import { units } from '../../data/units';
import MobileMenu from '../ui/MobileMenu.tsx';
import LanguageSwitch from '../ui/LanguageSwitch.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const navLinks = [
  { href: '#about', label: t('nav.about', lang) },
  { href: '#mission', label: t('nav.mission', lang) },
  {
    label: t('nav.units', lang),
    children: units.map(unit => ({
      href: lang === 'en' ? `/en/${unit.slug}` : `/${unit.slug}`,
      label: unit.name[lang],
      subtitle: unit.subtitle[lang],
      iconRoute: unit.iconRoute,
    })),
  },
  { href: '#contact', label: t('nav.contact', lang) },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-corp-dark/95 backdrop-blur-sm border-b border-white/10">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href={getLocalizedPath('/', lang)} class="flex items-center gap-3 shrink-0">
        <img src="/logo.svg" alt="Shema Yisrael" class="h-8 md:h-12 w-auto" />
        <span class="text-white font-semibold text-sm md:text-base tracking-wide">
          SHEMA YISRAEL S.R.L.
        </span>
      </a>

      <!-- Desktop Nav -->
     <div class="hidden md:flex items-center gap-6 lg:gap-8">
        <a
          href="#about"
          class="text-white/80 hover:text-white text-sm font-medium transition-colors"
        >
          {t('nav.about', lang)}
        </a>

        <a
          href="#mission"
          class="text-white/80 hover:text-white text-sm font-medium transition-colors"
        >
          {t('nav.mission', lang)}
        </a>

        <!-- Units Dropdown -->
        <div class="relative group">
          <button
            class="text-white/80 hover:text-white text-sm font-medium transition-colors flex items-center gap-1"
          >
            {t('nav.units', lang)}
            <svg class="w-4 h-4 mt-0.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div
            class="absolute left-0 top-full mt-3 w-80 rounded-xl bg-corp-dark/95 backdrop-blur-md
                  border border-white/10 shadow-xl opacity-0 invisible
                  group-hover:opacity-100 group-hover:visible
                  transition-all duration-200"
          >
            <ul class="p-3 space-y-1">
              {units.map(unit => (
                <li>
                  <a
                    href={lang === 'en' ? `/en/${unit.slug}` : `/${unit.slug}`}
                    class="block rounded-lg px-3 py-2 text-sm text-white/80 flex flex-row
                          hover:text-white hover:bg-white/5 transition"
                  >
                    <span class="font-medium flex justify-center items-center
                                  w-10 h-10 bg-white/5 rounded-lg shrink-0">
                      <img
                        src={unit.iconRoute}
                        alt={unit.name[lang]}
                        class={`object-contain filter brightness-0 invert ${unit.iconSize ? `w-${unit.iconSize} h-${unit.iconSize}` : ''}`}
                      />
                    </span>
                    <div class="pl-5">
                      <span class="font-medium">{unit.name[lang]}</span>
                      <span class="block text-xs text-white/40">{unit.subtitle[lang]}</span>
                    </div>
                    
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <a
          href="#contact"
          class="text-white/80 hover:text-white text-sm font-medium transition-colors"
        >
          {t('nav.contact', lang)}
        </a>

        <LanguageSwitch lang={lang} client:load />
      </div>


      <!-- Mobile Menu -->
      <div class="md:hidden flex items-center gap-3">
        <LanguageSwitch lang={lang} client:load />
        <MobileMenu links={navLinks} client:load />
      </div>
    </div>
  </nav>
</header>

<!-- Spacer for fixed header -->
<div class="h-16 md:h-20"></div>
