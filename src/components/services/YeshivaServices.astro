---
import type { Lang } from '../../i18n';
import { t } from '../../i18n';
import { yeshivaServices } from '../../data/services';
import { getUnit } from '../../data/units';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const unit = getUnit('yeshiva')!;

// Educational/institutional icons SVG paths
const icons: Record<string, string> = {
  'ambulance': 'M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0',
  'nurse': 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  'microscope-lab': 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
};

// Career features/highlights
const careerFeatures = [
  { icon: 'M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z', label: { es: 'Equipamiento Tecnologico', en: 'Modern Technology Equipment' } },
  { icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4', label: { es: 'Infraestructura Moderna', en: 'Modern Infrastructure' } },
  { icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z', label: { es: 'Docentes Especializados', en: 'Specialized Faculty' } },
  { icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z', label: { es: 'Prácticas Profesionales', en: 'Professional Internships' } },
];
---

<section class="py-16 md:py-24 bg-white relative">
  <!-- Institutional header band -->
  <div
    class="absolute top-0 left-0 right-0 h-2"
    style={`background: linear-gradient(90deg, ${unit.colors.primary}, ${unit.colors.secondary}, ${unit.colors.primary})`}
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header - Institutional Style -->
    <div class="text-center mb-16 animate-on-scroll">
      <!-- Academic badge -->
      <div
        class="inline-flex items-center gap-3 mb-6 px-6 py-3 rounded-lg"
        style={`background: ${unit.colors.light}; border: 2px solid ${unit.colors.primary}`}
      >
        <svg
          class="w-6 h-6"
          style={`color: ${unit.colors.secondary}`}
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
        </svg>
        <span
          class="text-sm font-bold uppercase tracking-wider"
          style={`color: ${unit.colors.secondary}`}
        >
          {t('unitPage.academicPrograms', lang)}
        </span>
      </div>

      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4"
        style={`color: ${unit.colors.secondary}`}
      >
        {t('unitPage.technicalCareers', lang)}
      </h2>

      <div class="flex items-center justify-center gap-4 mb-6">
        <div class="h-1 w-16 rounded-full" style={`background: ${unit.colors.primary}`}></div>
        <div class="w-3 h-3 rotate-45" style={`background: ${unit.colors.primary}`}></div>
        <div class="h-1 w-16 rounded-full" style={`background: ${unit.colors.primary}`}></div>
      </div>

      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        {t('unitPage.careersDesc', lang)}
      </p>
    </div>

    <!-- Institution Features Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16 animate-on-scroll">
      {careerFeatures.map((feature) => (
        <div
          class="text-center p-4 rounded-xl transition-all duration-300 hover:scale-105"
          style={`background: ${unit.colors.light}`}
        >
          <div
            class="w-12 h-12 mx-auto mb-3 rounded-lg flex items-center justify-center"
            style={`background: ${unit.colors.secondary}`}
          >
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.icon}></path>
            </svg>
          </div>
          <span
            class="text-xs md:text-sm font-semibold"
            style={`color: ${unit.colors.secondary}`}
          >
            {feature.label[lang]}
          </span>
        </div>
      ))}
    </div>

    <!-- Careers Cards - Institutional Academic Style with Images -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {yeshivaServices[0].services.map((career, index) => (
        <div
          class="group animate-on-scroll"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="relative bg-white border-2 border-gray-100 rounded-2xl overflow-hidden hover:border-gray-200 transition-all duration-300 hover:shadow-xl h-full flex flex-col">
            <!-- Career Image -->
            <div class="relative h-56 overflow-hidden">
              <img
                src={career.image || `/yeshiva/services/default.jpg`}
                alt={career.name[lang]}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                loading="lazy"
                onerror="this.src='https://images.unsplash.com/photo-1576091160399-112ba8d25d1f?w=400&h=300&fit=crop&auto=format'"
              />
              <!-- Overlay gradient -->
              <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/30 to-transparent"></div>

              <!-- Career number badge -->
              <div
                class="absolute top-4 left-4 w-12 h-12 rounded-xl flex items-center justify-center"
                style={`background: ${unit.colors.primary}`}
              >
                <span class="text-white font-bold text-xl">
                  {(index + 1).toString().padStart(2, '0')}
                </span>
              </div>

              <!-- Technical degree badge -->
              <div class="absolute top-4 right-4">
                <span
                  class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-bold uppercase backdrop-blur-sm"
                  style={`background: ${unit.colors.light}ee; color: ${unit.colors.secondary}`}
                >
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"></path>
                  </svg>
                  {career.id === 'enfermeria' || career.id === 'laboratorio-clinico'
                    ? t('unitPage.technicalMidDegree', lang)
                    : t('unitPage.technicalSuperiorDegree', lang)}
                </span>
              </div>

              <!-- Icon overlay at bottom -->
              <div
                class="absolute bottom-4 right-4 w-14 h-14 rounded-xl flex items-center justify-center backdrop-blur-sm transition-transform duration-300 group-hover:scale-110"
                style={`background: ${unit.colors.secondary}dd`}
              >
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icons[career.icon] || icons['nurse']}></path>
                </svg>
              </div>

              <!-- Title on image -->
              <div class="absolute bottom-4 left-4 right-20">
                <h3 class="text-xl md:text-2xl font-bold text-white drop-shadow-lg">
                  {career.name[lang]}
                </h3>
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-6 flex-1 flex flex-col">
              <!-- Description -->
              <p class="text-gray-600 leading-relaxed mb-6 text-sm line-clamp-4 flex-1">
                {career.description[lang]}
              </p>

              <!-- Career highlights -->
              <div class="flex flex-wrap gap-2">
                <div
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs"
                  style={`background: ${unit.colors.light}; color: ${unit.colors.secondary}`}
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="font-medium">{career.id === 'enfermeria' || career.id === 'laboratorio-clinico' ? 2 : 3} {t('unitPage.years', lang)}</span>
                </div>
                <div
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs"
                  style={`background: ${unit.colors.light}; color: ${unit.colors.secondary}`}
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                  </svg>
                  <span class="font-medium">{t('unitPage.officialTitle', lang)}</span>
                </div>
                <div
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs"
                  style={`background: ${unit.colors.light}; color: ${unit.colors.secondary}`}
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                  </svg>
                  <span class="font-medium">{t('unitPage.practicalTraining', lang)}</span>
                </div>
              </div>
            </div>

            <!-- Bottom accent -->
            <div
              class="h-1.5 w-0 group-hover:w-full transition-all duration-500"
              style={`background: linear-gradient(90deg, ${unit.colors.primary}, ${unit.colors.secondary}, ${unit.colors.accent})`}
            ></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Enrollment CTA - Institutional Style -->
    <div class="mt-16 animate-on-scroll">
      <div
        class="relative rounded-2xl overflow-hidden"
        style={`background: ${unit.colors.secondary}`}
      >
        <!-- Decorative pattern -->
        <div class="absolute inset-0 opacity-10">
          <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <pattern id="academic-pattern" width="80" height="80" patternUnits="userSpaceOnUse">
                <circle cx="40" cy="40" r="2" fill="white"/>
                <path d="M40 0v80M0 40h80" stroke="white" stroke-width="0.5" fill="none"/>
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#academic-pattern)"/>
          </svg>
        </div>

        <div class="relative z-10 p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
          <div class="text-center md:text-left">
            <div class="flex items-center justify-center md:justify-start gap-3 mb-4">
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center"
                style={`background: ${unit.colors.primary}`}
              >
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-white">
                {t('unitPage.startYourCareer', lang)}
              </h3>
            </div>
            <p class="text-white/80 max-w-lg">
              {t('unitPage.enrollmentDesc', lang)}
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="https://yeshivaedu.com/"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-bold text-lg transition-all duration-300 hover:scale-105 hover:shadow-xl"
              style={`background: ${unit.colors.primary}; color: white`}
            >
              {t('unitPage.enrollNow', lang)}
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a
              href="https://yeshivaedu.com/"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-bold text-lg border-2 border-white/30 text-white hover:bg-white/10 transition-all duration-300"
            >
              {t('unitPage.moreInfo', lang)}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .line-clamp-4 {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
