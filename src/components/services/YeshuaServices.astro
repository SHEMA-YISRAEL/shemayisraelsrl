---
import type { Lang } from '../../i18n';
import { t } from '../../i18n';
import { yeshuaServices } from '../../data/services';
import { getUnit } from '../../data/units';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const unit = getUnit('yeshua')!;

// Medical icons SVG paths
// Category images mapping
const categoryImages: Record<string, string> = {
  'ginecologia': '/yeshua/ginecologia.jpg',
  'fisioterapia': '/yeshua/fisioterapia.jpg',
  'psicologia': '/yeshua/psicologia.png',
  'imagenologia': '/yeshua/imageneologia.jpg',
};

const icons: Record<string, string> = {
  'medical-heart': 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  'microscope': 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  'test-tube': 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  'baby': 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2-1.343-2-3-2zm0 8c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm9-4c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z',
  'bone': 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M21 12c0-1.5-.5-2.5-1.5-3.5S17.5 7 16 7h-1V6c0-1-.5-2-1.5-2.5S11.5 3 10 3c-2.5 0-4 1.5-4 4v1H5c-1.5 0-2.5.5-3.5 1.5S0 11.5 0 13c0 2.5 1.5 4 4 4h2v1c0 1.5.5 2.5 1.5 3.5S9.5 23 11 23c2.5 0 4-1.5 4-4v-2h1c1.5 0 2.5-.5 3.5-1.5S21 13.5 21 12z',
  'joints': 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
  'skin': 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  'lungs': 'M12 4.5v15m0-15C10.5 3 8 2 6 4s-2 6 0 9c1.5 2 4 3 6 3m0-12c1.5-1.5 4-2.5 6-.5s2 6 0 9c-1.5 2-4 3-6 3',
  'elderly': 'M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  'brain': 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  'clipboard-check': 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
  'peace': 'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zm0-18v16m-5.66-2.34l5.66-5.66m0 0l5.66-5.66',
  'heart-pulse': 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z M3 12h4l2-4 4 8 2-4h4',
  'balance': 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3',
  'scan': 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z',
  'cube-3d': 'M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12',
  'video': 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
};
---

<section class="py-16 md:py-24 bg-gradient-to-b from-white to-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header - Hospital Style -->
    <div class="text-center mb-16 animate-on-scroll">
      <div class="inline-flex items-center gap-2 mb-4 px-4 py-2 rounded-full bg-blue-50 border border-blue-100">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
        <span class="text-sm font-semibold text-blue-700 uppercase tracking-wider">
          {t('unitPage.services', lang)}
        </span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">
        {t('unitPage.ourSpecialties', lang)}
      </h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        {t('unitPage.specialtiesDesc', lang)}
      </p>
    </div>

    <!-- Specialties Grid -->
    {yeshuaServices.map((category, catIndex) => (
      <div class="mb-20 last:mb-0 animate-on-scroll" style={`animation-delay: ${catIndex * 100}ms`}>
        <!-- Category Header with Image -->
        <div class="relative rounded-3xl overflow-hidden mb-8 shadow-xl" style={`box-shadow: 0 20px 50px -12px ${unit.colors.primary}30`}>
          <!-- Category Image -->
          <div class="relative h-64 md:h-80 2xl:h-130">
            <img
              src={categoryImages[category.id] || '/yeshua/ginecologia.jpg'}
              alt={category.name[lang]}
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <!-- Gradient Overlay -->
            <div class="absolute inset-0 bg-linear-to-r from-black/70 via-black/40 to-transparent"></div>

            <!-- Content over image -->
            <div class="absolute inset-0 flex items-center p-8 md:p-12">
              <div class="max-w-xl">
                <div
                  class="w-14 h-14 rounded-xl flex items-center justify-center shadow-lg mb-4"
                  style={`background: linear-gradient(135deg, ${unit.colors.primary}, ${unit.colors.secondary})`}
                >
                  <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                </div>
                <h3 class="text-3xl md:text-4xl font-bold text-white mb-3 drop-shadow-lg">
                  {category.name[lang]}
                </h3>
                <div class="h-1.5 w-24 rounded-full" style={`background: linear-gradient(90deg, ${unit.colors.primary}, ${unit.colors.accent})`}></div>
                <p class="text-white/80 mt-4 text-lg hidden md:block">
                  {lang === 'es'
                    ? 'Atención especializada con equipamiento de última generación'
                    : 'Specialized care with state-of-the-art equipment'}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Services Cards - Hospital Style -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {category.services.map((service, index) => (
            <div
              class="group relative bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-slate-100 hover:border-blue-200"
              style={`animation-delay: ${index * 50}ms`}
            >
              <!-- Top Accent Bar -->
              <div
                class="h-1.5 w-full"
                style={`background: linear-gradient(90deg, ${unit.colors.primary}, ${unit.colors.secondary})`}
              ></div>

              <!-- Card Content -->
              <div class="p-6">
                <!-- Icon -->
                <div
                  class="w-14 h-14 rounded-xl flex items-center justify-center mb-4 transition-transform duration-300 group-hover:scale-110"
                  style={`background-color: ${unit.colors.light}`}
                >
                  <svg
                    class="w-7 h-7 transition-colors duration-300"
                    style={`color: ${unit.colors.primary}`}
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icons[service.icon] || icons['medical-heart']}></path>
                  </svg>
                </div>

                <!-- Title -->
                <h4 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-blue-700 transition-colors duration-300">
                  {service.name[lang]}
                </h4>

                <!-- Description -->
                <p class="text-sm text-slate-600 leading-relaxed">
                  {service.description[lang]}
                </p>

                <!-- Medical Badge -->
                <div class="mt-4 flex items-center gap-2">
                  <span
                    class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium"
                    style={`background-color: ${unit.colors.light}; color: ${unit.colors.primary}`}
                  >
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    {t('unitPage.certified', lang)}
                  </span>
                </div>
              </div>

              <!-- Bottom accent bar on hover -->
              <div
                class="h-1 w-0 group-hover:w-full transition-all duration-300"
                style={`background: linear-gradient(90deg, ${unit.colors.primary}, ${unit.colors.secondary})`}
              ></div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
