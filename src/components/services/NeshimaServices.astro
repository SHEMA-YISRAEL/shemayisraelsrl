---
import type { Lang } from '../../i18n';
import { t } from '../../i18n';
import { neshimaServices } from '../../data/services';
import { getUnit } from '../../data/units';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const unit = getUnit('neshima')!;

// Aesthetic icons SVG paths
const icons: Record<string, string> = {
  'body-slim': 'M12 4.5c-1.5 0-2.5 1-2.5 2.5s1 2.5 2.5 2.5 2.5-1 2.5-2.5-1-2.5-2.5-2.5zm0 7c-2 0-4 1-4 3v6h8v-6c0-2-2-3-4-3z',
  'skin-care': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'sparkles': 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  'light-beam': 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  'face-clean': 'M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  'layers': 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  'waves': 'M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5',
  'blade': 'M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z',
  'target': 'M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 10c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6zm0-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z',
};
---

<section class="py-20 md:py-28 relative overflow-hidden" style={`background: linear-gradient(180deg, #faf8f5 0%, ${unit.colors.light} 50%, #faf8f5 100%)`}>
  <!-- Decorative Elements -->
  <div class="absolute top-0 left-0 w-96 h-96 opacity-20 blur-3xl" style={`background: radial-gradient(circle, ${unit.colors.primary}, transparent)`}></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 opacity-20 blur-3xl" style={`background: radial-gradient(circle, ${unit.colors.accent}, transparent)`}></div>

  <!-- Floating Decorative Shapes -->
  <div class="absolute top-20 right-20 w-32 h-32 rounded-full opacity-10 float-animation" style={`background: ${unit.colors.primary}`}></div>
  <div class="absolute bottom-40 left-10 w-20 h-20 rounded-full opacity-10 float-animation-delayed" style={`background: ${unit.colors.accent}`}></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header - Elegant Spa Style -->
    <div class="text-center mb-20 animate-on-scroll">
      <div class="inline-block mb-6">
        <div class="flex items-center justify-center gap-4">
          <div class="h-px w-12 bg-gradient-to-r from-transparent" style={`to: ${unit.colors.primary}`}></div>
          <span
            class="text-sm font-medium uppercase tracking-[0.3em]"
            style={`color: ${unit.colors.accent}`}
          >
            {t('unitPage.services', lang)}
          </span>
          <div class="h-px w-12 bg-gradient-to-l from-transparent" style={`to: ${unit.colors.primary}`}></div>
        </div>
      </div>
      <h2
        class="text-4xl md:text-5xl font-light mb-6"
        style={`color: ${unit.colors.secondary}`}
      >
        {t('unitPage.treatmentsTitle', lang)}
      </h2>
      <p class="text-lg text-stone-500 max-w-2xl mx-auto font-light leading-relaxed">
        {t('unitPage.treatmentsDesc', lang)}
      </p>
    </div>

    <!-- Treatment Categories -->
    {neshimaServices.map((category, catIndex) => (
      <div class="mb-24 last:mb-0 animate-on-scroll" style={`animation-delay: ${catIndex * 150}ms`}>
        <!-- Category Header - Elegant Style -->
        <div class="text-center mb-12">
          <div class="inline-flex items-center gap-3 mb-4">
            <div class="w-8 h-px" style={`background: ${unit.colors.primary}`}></div>
            <svg
              class="w-6 h-6"
              style={`color: ${unit.colors.primary}`}
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
            </svg>
            <div class="w-8 h-px" style={`background: ${unit.colors.primary}`}></div>
          </div>
          <h3
            class="text-2xl md:text-3xl font-light"
            style={`color: ${unit.colors.secondary}`}
          >
            {category.name[lang]}
          </h3>
        </div>

        <!-- Services Cards - Aesthetic Spa Style with Videos/Images -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {category.services.map((service, index) => (
            <div
              class="group relative"
              style={`animation-delay: ${index * 75}ms`}
            >
              <!-- Card with elegant design -->
              <div class="relative bg-white/80 backdrop-blur-sm rounded-3xl shadow-sm hover:shadow-2xl transition-all duration-500 border border-stone-100 hover:border-stone-200 overflow-hidden h-full">
                <!-- Service Video or Image -->
                <div class="relative h-52 overflow-hidden">
                  {service.videoId ? (
                    <!-- YouTube Video -->
                    <iframe
                      src={`https://www.youtube.com/embed/${service.videoId}?rel=0&modestbranding=1`}
                      title={service.name[lang]}
                      class="absolute inset-0 w-full h-full"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      loading="lazy"
                    ></iframe>
                  ) : (
                    <!-- Image fallback -->
                    <Fragment>
                      <img
                        src={service.image || `/neshima/services/default.jpg`}
                        alt={service.name[lang]}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                        loading="lazy"
                        onerror="this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=400&h=300&fit=crop&auto=format'"
                      />
                      <!-- Elegant overlay -->
                      <div class="absolute inset-0 bg-linear-to-t from-black/50 via-transparent to-transparent"></div>
                      <!-- Icon overlay -->
                      <div
                        class="absolute bottom-4 right-4 w-12 h-12 rounded-2xl flex items-center justify-center backdrop-blur-md transition-transform duration-300 group-hover:scale-110"
                        style={`background: ${unit.colors.primary}dd`}
                      >
                        <svg
                          class="w-6 h-6 text-white"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icons[service.icon] || icons['sparkles']}></path>
                        </svg>
                      </div>
                    </Fragment>
                  )}
                </div>

                <!-- Card Content -->
                <div class="p-6">
                  <!-- Title with elegant typography -->
                  <h4
                    class="text-xl font-medium mb-3 transition-colors duration-300"
                    style={`color: ${unit.colors.secondary}`}
                  >
                    {service.name[lang]}
                  </h4>

                  <!-- Elegant divider -->
                  <div class="w-12 h-0.5 mb-4 transition-all duration-300 group-hover:w-20" style={`background: linear-gradient(90deg, ${unit.colors.primary}, ${unit.colors.accent})`}></div>

                  <!-- Description -->
                  <p class="text-stone-500 text-sm leading-relaxed font-light line-clamp-3">
                    {service.description[lang]}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Floating animations for decorative elements */
  .float-animation {
    animation: float 8s ease-in-out infinite;
  }

  .float-animation-delayed {
    animation: float 8s ease-in-out infinite;
    animation-delay: 2s;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(5deg);
    }
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .float-animation,
    .float-animation-delayed {
      animation: none;
    }
  }
</style>
