---
import type { Lang } from '../../i18n';
import { getUnit } from '../../data/units';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const unit = getUnit('soluciones-tecnologicas')!;

const projects = [
  {
    id: 'topoquizz',
    name: 'TopoQuizz',
    logo: '/solucionesDigitales/topoquizz.webp',
    tagline: {
      es: 'Ahora puedes repasar tus conocimientos médicos jugando.',
      en: 'Now you can review your medical knowledge by playing.'
    },
    description: {
      es: 'Refuerza lo aprendido con más de 2.000 preguntas en diferentes niveles de dificultad.',
      en: 'Reinforce what you have learned with over 2,000 questions at different difficulty levels.'
    },
    cta: {
      es: '¡Te reto a jugarlo! ¿Te animas?',
      en: 'I challenge you to play it! Are you up for it?'
    },
    sectionTitle: {
      es: '¿Por qué practicar con TopoQuizz?',
      en: 'Why practice with TopoQuizz?'
    },
    features: [
      { es: 'Te motiva a estudiar más tiempo.', en: 'Motivates you to study longer.' },
      { es: 'Adaptado para estudiantes de medicina.', en: 'Adapted for medical students.' },
      { es: 'Preguntas validadas por especialistas.', en: 'Questions validated by specialists.' },
      { es: 'Estadísticas de progreso automáticas.', en: 'Automatic progress statistics.' },
      { es: 'Te prepara para exámenes.', en: 'Prepares you for exams.' }
    ],
    color: '#6366f1'
  },
  {
    id: 'neuremy',
    name: 'Neuremy',
    logo: '/solucionesDigitales/neuremy.svg',
    tagline: {
      es: '¿Qué es neuremy?',
      en: 'What is neuremy?'
    },
    description: {
      es: 'Es una plataforma digital de estudio diseñada para facilitar el aprendizaje de futuros médicos a través de lecciones estructuradas, recursos dinámicos y contenido interactivo.',
      en: 'It is a digital study platform designed to facilitate the learning of future doctors through structured lessons, dynamic resources, and interactive content.'
    },
    sectionTitle: {
      es: 'TODO LO QUE NECESITAS PARA ESTUDIAR MEDICINA',
      en: 'EVERYTHING YOU NEED TO STUDY MEDICINE'
    },
    subtitle: {
      es: 'Aprende y practica desde dónde estés.',
      en: 'Learn and practice from wherever you are.'
    },
    features: [
      { es: 'Clases con especialistas', en: 'Classes with specialists' },
      { es: 'Contenido actualizado', en: 'Updated content' },
      { es: 'Materias esenciales', en: 'Essential subjects' },
      { es: 'Bibliografía médica confiable', en: 'Reliable medical bibliography' },
      { es: 'Acceso 24/7', en: '24/7 Access' },
      { es: 'Recursos dinámicos', en: 'Dynamic resources' }
    ],
    color: '#05b2dc'
  }
];

const sectionTexts = {
  badge: { es: 'En Desarrollo', en: 'In Development' },
  title: { es: 'Proyectos en Desarrollo', en: 'Projects in Development' },
  subtitle: {
    es: 'Actualmente estamos desarrollando soluciones innovadoras para el sector educativo médico.',
    en: 'We are currently developing innovative solutions for the medical education sector.'
  }
};
---

<section class="py-16 md:py-24 bg-gradient-to-b from-white to-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-on-scroll">
      <div class="inline-flex items-center gap-2 mb-4 px-4 py-2 rounded-full bg-indigo-50 border border-indigo-100">
        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
        </svg>
        <span class="text-sm font-semibold text-indigo-700 uppercase tracking-wider">
          {sectionTexts.badge[lang]}
        </span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">
        {sectionTexts.title[lang]}
      </h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        {sectionTexts.subtitle[lang]}
      </p>
    </div>

    <!-- Projects -->
    <div class="space-y-20">
      {projects.map((project, index) => (
        <div class={`animate-on-scroll ${index % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100">
            <!-- Project Header -->
            <div
              class="relative p-8 md:p-12"
              style={`background: linear-gradient(135deg, ${project.color}15 0%, ${project.color}05 100%)`}
            >
              <div class="flex flex-col lg:flex-row items-center gap-8">
                <!-- Logo -->
                <div class="flex-shrink-0">
                  <div
                    class="w-auto h-30 bg-sky-50 md:w-auto md:h-40 object-contain rounded-2xl overflow-hidden shadow-2xl shadow-sky-200/10 transform hover:scale-105 transition-transform duration-300"
                    style={`box-shadow: 0 25px 50px -12px ${project.color}40`}
                  >
                    <img
                      src={project.logo}
                      alt={project.name}
                      class="w-full h-full object-cover"
                    />
                  </div>
                </div>

                <!-- Info -->
                <div class="flex-1 text-center lg:text-left">
                  <h3
                    class="text-3xl md:text-4xl font-bold mb-4"
                    style={`color: ${project.color}`}
                  >
                    {project.name}
                  </h3>
                  <p class="text-xl md:text-2xl font-medium text-slate-700 mb-4">
                    {project.tagline[lang]}
                  </p>
                  <p class="text-slate-600 text-lg leading-relaxed max-w-2xl">
                    {project.description[lang]}
                  </p>
                  {project.cta && (
                    <p class="mt-4 text-lg font-semibold" style={`color: ${project.color}`}>
                      {project.cta[lang]}
                    </p>
                  )}
                </div>
              </div>
            </div>

            <!-- Features Section -->
            <div class="p-8 md:p-12 bg-gradient-to-br from-slate-50 to-white">
              <h4 class="text-xl md:text-2xl font-bold text-slate-800 mb-2 text-center lg:text-left">
                {project.sectionTitle[lang]}
              </h4>
              {project.subtitle && (
                <p class="text-slate-600 mb-8 text-center lg:text-left text-lg">
                  {project.subtitle[lang]}
                </p>
              )}

              <!-- Features Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {project.features.map((feature) => (
                  <div
                    class="flex items-center gap-3 p-4 rounded-xl bg-white border border-slate-100 hover:border-slate-200 hover:shadow-md transition-all duration-300"
                  >
                    <div
                      class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center"
                      style={`background-color: ${project.color}15`}
                    >
                      <svg
                        class="w-5 h-5"
                        style={`color: ${project.color}`}
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                    </div>
                    <span class="text-slate-700 font-medium">
                      {feature[lang]}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Coming Soon Badge -->
    <div class="mt-16 text-center animate-on-scroll">
      <div
        class="inline-flex items-center gap-3 px-6 py-3 rounded-full"
        style={`background: linear-gradient(135deg, ${unit.colors.primary}10, ${unit.colors.accent}10); border: 2px dashed ${unit.colors.primary}40`}
      >
        <svg class="w-6 h-6 animate-pulse" style={`color: ${unit.colors.primary}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="text-lg font-semibold" style={`color: ${unit.colors.primary}`}>
          {lang === 'es' ? 'Próximamente disponibles' : 'Coming soon'}
        </span>
      </div>
    </div>
  </div>
</section>
